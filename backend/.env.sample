# ==============================================================================
# TRUSTCHAIN BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in real values. .env is gitignored — never commit it.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS Origin for Frontend Client
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL Read-Cache / Prisma ORM)
# Local: postgresql://postgres:postgres@localhost:5432/beltal?schema=public
# Cloud (Neon/Supabase): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beltal?schema=public"

# Blockchain Provider & Smart Contracts (Ethereum Sepolia Testnet / Local Node)
# Local Hardhat/Anvil: http://127.0.0.1:8545
# Ethereum Sepolia: https://ethereum-sepolia-rpc.publicnode.com (or an Infura/Alchemy Sepolia endpoint)
RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Dedicated key for the ROLE_SYSTEM_CONNECTOR machine identity (PACS/HRMS
# automated ingest, issue #74) — kept separate from DEPLOYER_PRIVATE_KEY so
# machine-submitted transactions are attributable to the machine identity,
# not the human admin service key. Falls back to DEPLOYER_PRIVATE_KEY (with
# a warning logged) if left unset.
SYSTEM_CONNECTOR_PRIVATE_KEY=

# JWT Authentication
JWT_SECRET=trustchain-dev-secret-key-32chars-min-len
JWT_EXPIRES_IN=24h

# PII Dossier Encryption (AES-256-GCM, 32-byte key as 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random dev-only key is generated per process start (won't survive a restart).
DOSSIER_ENCRYPTION_KEY=

# Decentralized Storage (Pinata / IPFS for Encrypted Dossiers & Asset Specs)
# Modern Pinata uses the JWT (Secret Access Token). You can also set Key & Secret.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
